rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        getUserData().role == 'admin'
      );
    }

    function isInstructor() {
      return isAuthenticated() && (
        request.auth.token.role == 'instructor' ||
        getUserData().role == 'instructor'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isUser(userId) || isAdmin() || isInstructor());
      allow create: if isUser(userId)
        && request.resource.data.role == 'customer'
        && request.resource.data.remainingCredits == 0
        && request.resource.data.status == 'active';
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isUser(userId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny([
           'role', 'remainingCredits', 'status', 'activeMembershipId'
         ]))
      );
      allow delete: if isAdmin();
    }

    // Instructors Collection
    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isInstructor()
        && resource.data.instructorId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['capacity', 'bookedSeats'])
      );
    }

    // Packages Collection
    match /packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Official GVYA Membership Plans
    match /membershipPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public Membership & Free Trial Enquiries: schema-validated creation, admin-only read/manage
    match /membershipEnquiries/{enquiryId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && request.resource.data.status in ['new', 'enrolled']
        && (!('amountPaid' in request.resource.data) || (
          request.resource.data.amountPaid is number
          && request.resource.data.amountPaid >= 0
          && request.resource.data.amountPaid <= 500000
        ));
      allow update, delete: if isAdmin();
    }

    // Memberships Collection: STRICTLY admin/Cloud Function writable (prevents free-unlimited exploit!)
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Bookings Collection: Mutated server-side via Cloud Functions (Admin SDK) or Admin
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isInstructor()
      );
      allow write: if isAdmin();
    }

    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payments Collection: Customers may only create 'pending' positive-amount submissions without self-verifying
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 500000
        && !('verifiedBy' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Attendance Collection
    match /attendance/{attendanceId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isInstructor()
      );
      allow write: if isAdmin() || isInstructor();
    }

    // Activity Logs Collection: Immutable audit trail, ownership enforced
    match /activityLogs/{logId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.userId == request.auth.uid && request.resource.data.actorRole == 'customer')
      );
      allow update, delete: if false;
    }

    // Studio Settings Collection
    match /studioSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
